<FindBugsFilter>
    <Match>
        <Class name="~.*"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,CT_CONSTRUCTOR_THROW"/>
    </Match>
    <Match>
        <Class name="org.dellroad.muxable.simple.ProtocolWriter"/>
        <Method name="sendData"/>
        <Bug pattern="SF_SWITCH_FALLTHROUGH"/>
    </Match>
    <Match>
        <Class name="org.dellroad.muxable.simple.SimpleMuxableChannel"/>
        <Field name="~peer(Input|Output)"/>
        <Bug pattern="IS2_INCONSISTENT_SYNC"/>
    </Match>
</FindBugsFilter>
